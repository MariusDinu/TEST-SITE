    if(thumbs[lbCurrent]){
      thumbs[lbCurrent].scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
    }
  }

  window.openLightbox = function(key){
    var data = galleries[key];
    if(!data) return;
